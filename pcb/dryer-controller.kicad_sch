        (size 2.54 2.54) bold)
      (justify left bottom))
    (uuid "cb5f2c92-5387-4c75-bd6d-9859cea7f277"))
  (text "6  Sensor, panel and load-cell connectors"
    (at 322 130 0)
    (effects
      (font
        (size 2.54 2.54) bold)
      (justify left bottom))
    (uuid "6d11b27e-5f35-4fca-9b37-22726f3f6235"))
  (text "7  Scales: HX711 (U8 parts: 2-roll only)"
    (at 425 205 0)
    (effects
      (font
        (size 2.54 2.54) bold)
      (justify left bottom))
    (uuid "62367296-0fd3-47cc-8ae5-f64de31e7581"))
  (text "8  Feeder drivers (2-roll build only)"
    (at 425 30 0)
    (effects
      (font
        (size 2.54 2.54) bold)
      (justify left bottom))
    (uuid "16eefdc4-92b5-4027-a5d6-6594be671e72"))
  (text "2b  USB (data only) and 3.3 V"
    (at 280 250 0)
    (effects
